    {
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 0,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "id": "t155",
      "type": "text",
      "x": 560,
      "y": 2772,
      "width": 397.8,
      "height": 97.5,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "text": "torch has no wheel for Python 3.14 on this\nmachine, so the CNN and ViT experts are MLPs on\ndifferent feature views. Nothing in the code claims\nthey are CNNs. Replacing them means implementing\nfit/predict_proba in experts/torch_experts.py —\nno other module changes.",
      "originalText": "torch has no wheel for Python 3.14 on this\nmachine, so the CNN and ViT experts are MLPs on\ndifferent feature views. Nothing in the code claims\nthey are CNNs. Replacing them means implementing\nfit/predict_proba in experts/torch_experts.py —\nno other module changes.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "roundness": null
    },
    {
      "angle": 0,
